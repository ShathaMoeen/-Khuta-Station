# Copy to .env and fill DATABASE_URL and secrets locally. Never commit .env.
DATABASE_URL=
APP_ENV=development
APP_NAME=KHUTA API
API_PREFIX=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Configure only the provider key you use. Keep real keys in backend/.env.
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=YOUR_GEMINI_GENERATION_MODEL
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
PGVECTOR_ENABLED=true
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.72
CROWDING_WINDOW_MINUTES=5
CROWDING_HIGH_ACTIVE_INTERACTIONS=8
APPROVED_SHARIAH_SOURCES=
ADMIN_API_KEY=
DEVICE_API_KEY=
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
